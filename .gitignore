__pycache__/
*.pyc
*.pyo
.env

# ── Config locale (réglages machine, non versionnés) ────────────────
config.ini
config.ini.tmp

# ── Données personnelles (prompts / workflows / profiler) ────────────
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
# Sidecars WAL/SHM et sauvegardes de migration de schéma : ces fichiers sont des
# données d'utilisateur, jamais du code (cf. holaf_user_paths.py).
*.sqlite-shm
*.sqlite.backup_*

# ── Cache & artefacts temporaires (téléchargements, exports, binaires) ─
.cache/
temp_uploads/
temp_exports/
bin/

# ── Host keys SFTP (TOFU) ────────────────────────────────────────────
.sftp_known_hosts

# ── ComfyCH : la configuration (clé API en clair) et les journaux d'opération
# vivent dans l'arborescence utilisateur (user/default/AI-Helper/), PAS ici.
# Ces deux lignes évitent qu'un ancien fichier déposé dans tools/comfych/ (avant
# migration) soit commité avec la clé API.
tools/comfych/config.json
tools/comfych/config.json.migrated*
tools/comfych/logs/
