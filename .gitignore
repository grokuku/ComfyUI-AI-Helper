__pycache__/
*.pyc
*.pyo
.env

# ── Config locale (réglages machine, non versionnés) ────────────────
config.ini
config.ini.tmp

# ── Données personnelles (prompts / workflows / profiler) ────────────
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
# Sidecars WAL/SHM et sauvegardes de migration de schéma : ces fichiers sont des
# données d'utilisateur, jamais du code (cf. holaf_user_paths.py).
*.sqlite-shm
*.sqlite.backup_*

# ── Cache & artefacts temporaires (téléchargements, exports, binaires) ─
.cache/
temp_uploads/
temp_exports/
bin/

# ── Host keys SFTP (TOFU) ────────────────────────────────────────────
.sftp_known_hosts
